{
  "name": "dsh-sticky-notes",
  "version": "2.1.0",
  "description": "DeepSeek Harness 便签：按 DSH 工作区分区、按编号交给 AI；用量栏一下就是新建输入框，侧栏「自动化任务」下面有独立便签页，AI 用 sticky_notes 工具按编号增删改查。",
  "author": "moss",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/ismoss/dsh-plugins.git",
    "directory": "plugins/dsh-sticky-notes"
  },
  "scripts": {
    "test": "node test/logic.mjs",
    "check": "node --check client.js && node --check index.js && node --check notes.js && node --check store.js && node test/logic.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "notes.js",
    "store.js",
    "workspace.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "DEVELOPING.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
